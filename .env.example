# Telemachus server URL (where the agent runs)
TELEMACHUS_URL=http://localhost:8080
TELEMACHUS_TOKEN=your-telemachus-bearer-token

# Mattermost incoming webhook (where we POST replies)
MATTERMOST_WEBHOOK_URL=https://mattermost.example.com/hooks/xxxx

# Optional: token Mattermost sends with outgoing webhooks (verify origin)
MATTERMOST_OUTGOING_TOKEN=optional-shared-secret

# Bot HTTP server
PORT=3000
